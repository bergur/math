{
  "name": "math",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "npm run build && npm run serve",
    "build": "vite build",
    "serve": "node --env-file-if-exists=.env server/index.ts",
    "dev:server": "node --env-file-if-exists=.env --watch server/index.ts",
    "dev:client": "vite",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "express": "^5.3.0",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9",
    "vite": "^8.3.4",
    "vue-tsc": "^3.3.13"
  }
}
